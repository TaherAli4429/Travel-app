# Database Connection
# Replace YOUR_PASSWORD with your local PostgreSQL postgres user password
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/wanderly_db

# Security & JWT Configuration
JWT_SECRET_KEY=wanderly_secret_jwt_key_super_secure_development_2026_change_in_prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Application Settings
API_V1_PREFIX=/api/v1
APP_NAME=Wanderly API
APP_ENV=development
DEBUG=True

# CORS Settings (comma-separated origins)
CORS_ORIGINS=http://localhost,http://localhost:3000,http://127.0.0.1,http://127.0.0.1:8000,http://localhost:8000,http://localhost:*
